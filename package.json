{
  "name": "playtested",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:testing-policy": "node tests/test-testing-policy.mjs && node tests/test-tester-regressions.mjs",
    "test:tester-browser": "node tests/test-tester-browser.mjs",
    "typecheck:testing-policy": "tsc --noEmit -p tsconfig.policy-check.json",
    "test:unit": "node tests/test-tester-regressions.mjs && node tests/test-feedback-actions.mjs && node tests/test-playtime.mjs && node tests/test-rank-summary.mjs && node tests/test-share-links.mjs",
    "test:workspace": "node tests/test-developer-workspace.mjs --server-only",
    "test:share": "node tests/test-share-links.mjs && node tests/test-share-engagement.mjs",
    "test:share:browser": "node tests/test-share-engagement-browser.mjs",
    "test:submissions": "node tests/test-submission-corrections.mjs",
    "test:submissions:browser": "node tests/test-submission-correction-browser.mjs",
    "test:recovery-safeguards": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/test-backup-safeguards.ps1",
    "worker:pulse": "node --env-file=.env.local scripts/workers/pulse-job-runner-v9.mjs",
    "worker:steam": "node --env-file=.env.local scripts/workers/steam-queue-worker.mjs",
    "worker:steam-backfill": "node --env-file=.env.local scripts/workers/steam-content-backfill-worker.mjs",
    "worker:technical": "node scripts/workers/technical-test-worker-v6.10.mjs",
    "maintenance:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance/apply-authorized-testing-update.ps1",
    "maintenance:seed-demos": "node scripts/maintenance/seed-demo-playtests.mjs",
    "recovery:readiness": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/check-backup-readiness.ps1",
    "recovery:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/backup-database.ps1",
    "test:reservations": "node tests/test-testing-policy.mjs --reservations-only",
    "test:reservations:concurrency": "node tests/test-testing-policy.mjs --reservations-concurrency",
    "test:feedback-quality": "node tests/test-testing-policy.mjs --graded-quality",
    "test:feedback-quality:concurrency": "node tests/test-testing-policy.mjs --quality-concurrency",
    "test:feedback-quality:browser": "node tests/test-admin-feedback-browser.mjs",
    "test:feedback-tabs": "node tests/test-build-results-selection.mjs --browser",
    "test:developer-plans": "node tests/test-developer-launch-limit.mjs --plans",
    "test:developer-plans:concurrency": "node tests/test-testing-policy.mjs --plan-concurrency",
    "test:developer-plans:browser": "node tests/test-developer-workspace.mjs --plans-browser"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
