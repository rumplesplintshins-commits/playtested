# Local preview environment (localhost:3002) — isolated development database.
# DO NOT use production Supabase credentials here.
# Copy to .env.local and fill in your local Supabase values.

# Local Supabase (run `supabase start` or point at your isolated dev instance)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# Next.js
NEXTAUTH_URL=http://localhost:3002
